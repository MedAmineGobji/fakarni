# Copier ce fichier en .env (ne jamais committer .env)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=fakarni
POSTGRES_USER=fakarni
POSTGRES_PASSWORD=fakarni
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Firebase (optionnel) : clé du compte de service, ne jamais la committer
# FCM_CREDENTIALS_FILE=/app/secrets/firebase.json
